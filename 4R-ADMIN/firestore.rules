rules_version = '2';

/* ==========================================================
   4R BET  |  Firestore Security Rules  (SECURE)
   Firebase Console > Firestore Database > Rules me paste karein
   --------------------------------------------------------------
   Ab sirf admin (4r@admin.com) hi complaints dekh / badal / delete
   kar sakta hai. Koi bhi user nayi complaint bhej sakta hai.

   IMPORTANT : Neeche ADMIN_EMAIL change karna ho to sirf us
   ek line ko badal dein - baaki rules same rahenge.
   ========================================================== */

service cloud.firestore {
  match /databases/{database}/documents {

    /* Admin ka login email - isko hi rules me likha gaya hai */
    function adminEmail() {
      return "4r@admin.com";
    }

    function isAdmin() {
      return request.auth != null
          && request.auth.token.email == adminEmail();
    }

    match /complaints/{complaintId} {

      /* Koi bhi user complaint bhej sakta hai (login ke bina) */
      allow create: if true;

      /* Sirf admin padh sakta hai */
      allow read: if isAdmin();

      /* Sirf admin status badal sakta hai, aur sirf status field */
      allow update: if isAdmin()
                    && request.resource.data.status is string
                    && request.resource.data.diff(resource.data)
                       .affectedKeys().hasOnly(['status', 'statusAt']);

      /* Sirf admin delete kar sakta hai */
      allow delete: if isAdmin();
    }
  }
}
